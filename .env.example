// DATABASE_URL fornecido pelo EasyPanel (serviço PostgreSQL interno)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solucao_inventario?schema=public"

# Segredo utilizado para assinar os tokens JWT (auth via cookie)
AUTH_SECRET="troque-esta-chave-por-uma-string-aleatoria-e-segura"

# URL base da aplicação (utilizada em cookies, redirecionamentos e links)
AUTH_URL="http://localhost:3000"

# Diretório de upload persistente (utilizar volume no EasyPanel)
UPLOAD_DIR="./uploads"
