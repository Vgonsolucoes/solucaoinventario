// Prisma schema - Solução Inventário
// Versão inicial - Modelos base para gestão de patrimônio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(USER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  auditLogs                     AuditLog[]
  inventariosComoResponsavel    Inventario[]     @relation("InventarioResponsavel")
  inventarioItensLidos          InventarioItem[] @relation("InventarioItemLidoPor")
  anexos                        Anexo[]          @relation("AnexoUploadedBy")
  movimentacoesPatrimonio       HistoricoLocal[] @relation("HistoricoMovimentadoPor")
}

enum UserRole {
  ADMIN
  USER
  AUDITOR
}

model Colaborador {
  id            String       @id @default(uuid())
  matricula     String       @unique
  nome          String
  cargo         String?
  email         String?
  telefone      String?
  setorId       String
  setor         Setor        @relation(fields: [setorId], references: [id])
  ativo         Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  patrimonios   Patrimonio[]
  inventarios   Inventario[]
}

model Setor {
  id            String        @id @default(uuid())
  nome          String
  descricao     String?
  ativo         Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  colaboradores Colaborador[]
  patrimonios   Patrimonio[]
  inventarios   Inventario[]
}

model Categoria {
  id          String       @id @default(uuid())
  nome        String
  descricao   String?
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  patrimonios Patrimonio[]
}

model Patrimonio {
  id             String           @id @default(uuid())
  tombamento     String           @unique
  descricao      String
  numeroSerie    String?
  modelo         String?
  marca          String?
  valorCompra    Decimal?         @db.Decimal(12, 2)
  dataCompra     DateTime?
  estado         PatrimonioEstado @default(BOM)
  observacao     String?
  qrCodeData     String?
  categoriaId    String
  categoria      Categoria        @relation(fields: [categoriaId], references: [id])
  setorId        String
  setor          Setor            @relation(fields: [setorId], references: [id])
  colaboradorId  String?
  colaborador    Colaborador?     @relation(fields: [colaboradorId], references: [id])
  ativo          Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  anexos         Anexo[]
  inventarioItens InventarioItem[]
  historicoLocal HistoricoLocal[]
}

enum PatrimonioEstado {
  NOVO
  BOM
  REGULAR
  RUIM
  INSERVIVEL
  DESCARTADO
}

model Inventario {
  id              String           @id @default(uuid())
  nome            String
  descricao       String?
  dataInicio      DateTime
  dataFim         DateTime?
  status          InventarioStatus @default(ABERTO)
  setorId         String?
  setor           Setor?           @relation(fields: [setorId], references: [id])
  colaboradorId   String?
  colaborador     Colaborador?     @relation(fields: [colaboradorId], references: [id])
  responsavelId   String?
  responsavel     User?            @relation("InventarioResponsavel", fields: [responsavelId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  itens           InventarioItem[]
}

enum InventarioStatus {
  ABERTO
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

model InventarioItem {
  id            String              @id @default(uuid())
  inventarioId  String
  inventario    Inventario          @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  patrimonioId  String
  patrimonio    Patrimonio          @relation(fields: [patrimonioId], references: [id])
  status        InventarioItemStatus @default(PENDENTE)
  localizado   Boolean             @default(false)
  observacao    String?
  lidoPorId     String?
  lidoPor       User?               @relation("InventarioItemLidoPor", fields: [lidoPorId], references: [id])
  lidoEm        DateTime?
  localInformado String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([inventarioId, patrimonioId])
}

enum InventarioItemStatus {
  PENDENTE
  CONFERIDO
  AUSENTE
  DIVERGENTE
  SOBRANTE
}

model Anexo {
  id           String     @id @default(uuid())
  patrimonioId String
  patrimonio   Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)
  nomeArquivo  String
  caminho      String
  tipo         String
  tamanhoBytes BigInt
  mimeType     String?
  descricao    String?
  uploadedById String?
  uploadedBy   User?      @relation("AnexoUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())
}

model HistoricoLocal {
  id           String     @id @default(uuid())
  patrimonioId String
  patrimonio   Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)
  setorAnteriorId String?
  setorNovoId   String
  colaboradorAnteriorId String?
  colaboradorNovoId String?
  motivo       String?
  movimentadoById String?
  movimentadoBy User?    @relation("HistoricoMovimentadoPor", fields: [movimentadoById], references: [id])
  createdAt    DateTime   @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
